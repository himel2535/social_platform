# Production / deployed backend (default):
EXPO_PUBLIC_API_URL=https://social-platform-f13o.onrender.com/api

# Local backend overrides — create mobile/.env.local instead of editing .env:
# iOS simulator / web:  EXPO_PUBLIC_API_URL=http://localhost:5000/api
# Android emulator:     EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
# Physical device:      EXPO_PUBLIC_API_URL=http://YOUR_MACHINE_IP:5000/api
