PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/social_platform
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/social_platform_test
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Development: leave empty — all localhost Expo Web ports are allowed automatically
# Production: set to your deployed frontend origin (e.g. https://app.example.com)
CLIENT_URL=
# Production fallback: comma-separated extra origins (optional)
CORS_ORIGIN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
